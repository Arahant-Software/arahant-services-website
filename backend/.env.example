# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.

# Server
PORT=5000
# Comma-separate multiple allowed origins, e.g. https://arahant.co.nz,https://www.arahant.co.nz
FRONTEND_URL=http://localhost:3000

# MySQL — connection details for the "Get a Call Back" form storage
# In production (backend + MySQL on the same GoDaddy/cPanel account), use DB_HOST=localhost.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Resend — used to email new "Get a Call Back" submissions (over HTTPS, not SMTP,
# since SMTP is blocked outbound on some hosting platforms including GoDaddy's
# Node.js hosting). Sign up at resend.com and create an API key.
RESEND_API_KEY=
