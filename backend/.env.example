# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.

# Server
PORT=5000
# Comma-separate multiple allowed origins, e.g. https://arahant.co.nz,https://www.arahant.co.nz
FRONTEND_URL=http://localhost:3000

# MySQL — connection details for the "Get a Call Back" form storage
# In production (backend + MySQL on the same GoDaddy/cPanel account), use DB_HOST=localhost.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Gmail SMTP — used to email new "Get a Call Back" submissions to info@arahant.co.nz
# 1. Enable 2-Step Verification on the sending Gmail account.
# 2. Go to Google Account -> Security -> App Passwords, generate one for "Mail".
# Note: outbound SMTP (ports 465 and 587) was confirmed blocked on GoDaddy's
# Node.js hosting platform — this works locally/on other hosts, may not there.
GMAIL_USER=
GMAIL_APP_PASSWORD=
