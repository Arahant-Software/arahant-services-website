# Copy this file to .env and fill in the values below.
# .env is gitignored and must never be committed.

# Server
PORT=5000
# Comma-separate multiple allowed origins, e.g. https://arahant.co.nz,https://www.arahant.co.nz
FRONTEND_URL=http://localhost:3000

# MySQL — connection details for the "Get a Call Back" form storage
# In production (backend + MySQL on the same GoDaddy/cPanel account), use DB_HOST=localhost.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=

# Gmail API (OAuth2, over HTTPS) — used to email new "Get a Call Back" submissions
# to info@arahant.co.nz through the account below. Not SMTP, since outbound SMTP
# (ports 465 and 587) was confirmed blocked on GoDaddy's Node.js hosting platform.
# Setup: Google Cloud Console -> new project -> enable Gmail API -> OAuth consent
# screen (External, add this Gmail account as a test user) -> Credentials -> OAuth
# client ID (type: Web application, add https://developers.google.com/oauthplayground
# as an authorized redirect URI) -> use those credentials in the OAuth Playground
# (gear icon -> "Use your own OAuth credentials") to authorize scope
# https://www.googleapis.com/auth/gmail.send as this Gmail account, then exchange
# the authorization code for tokens and copy the refresh token.
GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
